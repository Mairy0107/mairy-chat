# 复制为根目录 .env，仅填写本地数据库配置，不要提交真实密码。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=mairy_chat_user
DB_PASSWORD=replace_with_local_password
SERVER_PORT=8080

# 多个地址用英文逗号分隔；仅用于本地开发的 HTTP / WebSocket 来源校验。
CHAT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Vite 代理的后端地址；不要使用 VITE_ 前缀放置数据库密码。
DEV_BACKEND_URL=http://127.0.0.1:8080
