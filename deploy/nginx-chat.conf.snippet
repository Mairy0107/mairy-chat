  # Mairy Chat SPA + API + WebSocket (mounted at /usr/share/nginx/html/chat)
  location = /chat {
    return 301 /chat/;
  }

  location /chat/api/ {
    proxy_pass http://chat-api:8080/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /chat/ws/ {
    proxy_pass http://chat-api:8080/ws/;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  # Static hashed assets must 404 if missing (never SPA-fallback to index.html)
  location /chat/assets/ {
    try_files $uri =404;
    access_log off;
    expires 7d;
    add_header Cache-Control "public";
  }

  location /chat/ {
    try_files $uri $uri/ /chat/index.html;
  }
